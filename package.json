{
  "name": "nexus-gesture-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-mediapipe-wasm.mjs && tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
